[Unit]
Description=AMSS Reveal.js presentation service
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/.local/share/amss-presentation/app
EnvironmentFile=%h/.config/amss-presentation/environment
ExecStart=%h/.local/share/amss-presentation/runtime/node/bin/node %h/.local/share/amss-presentation/app/server.mjs
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
UMask=0077

[Install]
WantedBy=default.target
