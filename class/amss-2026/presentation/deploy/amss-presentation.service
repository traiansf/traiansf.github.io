[Unit]
Description=AMSS Reveal.js presentation service
After=network.target

[Service]
Type=simple
User=amss-presentation
Group=amss-presentation
WorkingDirectory=/opt/amss-presentation
EnvironmentFile=/etc/amss-presentation.env
ExecStart=/usr/bin/node /opt/amss-presentation/server.mjs
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
